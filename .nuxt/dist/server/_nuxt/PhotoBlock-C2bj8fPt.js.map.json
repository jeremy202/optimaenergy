{"file":"PhotoBlock-C2bj8fPt.js","mappings":";;;;;;;;;;;;;;mBAaOA,eAAAC,WAAA,EAAA,OAAM,sBAAA,GAAqB,MAAA,CAAA,qDACmB,QAAA,MAAA,GAAK,SAAA,CAAA,qBAAO,QAAA,OAAO,sCACb,QAAA,QAAK,eAAA,IAAA,oCAAA,CAAA,qBAAyB,QAAA,KAAK;UACjF,QAAA,aAAW;2CAAiE,QAAA,QAAK,mBAAA,kBAAA,gDAAA,CAAA,qBACrF,QAAA,WAAW;;;;;;;;;;;;;;;;;;;;;;;;;;;QCHhB,OAAM;AAAA,QACL,OAAK,EAAA,aAAiB,QAAA,IAAE,YAAc,QAAA,MAAG,gBAAA,4DAAA;AAAA,MAAA;UAIlC,QAAA,KAAG;qBACRC,cAAA,OAAK,QAAA,GAAG,IACRA,cAAA,OAAK,QAAA,SAAK,EAAA;;;UAKI,MAAM,QAAA;AAAA,UAAM,MAAK;AAAA,UAAqC,OAAM;AAAA,QAAA;;AAOrE,UAAA,QAAA,OAAO,QAAA,OAAK;;;;;UAMZ,QAAA,OAAK;6CAEH,QAAA,MAAG,eAAA,iBAAA,wGAAA,CAAA,qBAER,QAAA,KAAK;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderAttr"],"sources":["../../../../components/SectionHeading.vue","../../../../components/PhotoBlock.vue"],"sourcesContent":["<script setup lang=\"ts\">\nwithDefaults(\n  defineProps<{\n    eyebrow: string\n    title: string\n    description?: string\n    light?: boolean\n  }>(),\n  { light: false }\n)\n</script>\n\n<template>\n  <div class=\"max-w-[640px] mb-14\">\n    <span class=\"eyebrow\" :class=\"{ 'eyebrow-light': light }\">{{ eyebrow }}</span>\n    <h2 class=\"mt-4 text-[clamp(20px,3.6vw,44px)]\" :class=\"light ? 'text-white' : ''\">{{ title }}</h2>\n    <p v-if=\"description\" class=\"mt-[18px] text-[15px] sm:text-lg leading-[1.7]\" :class=\"light ? 'text-[#B9C6DE]' : 'text-ink-muted'\">\n      {{ description }}\n    </p>\n  </div>\n</template>\n","<script setup lang=\"ts\">\nwithDefaults(\n  defineProps<{\n    icon?: string\n    label?: string\n    ar?: string\n    src?: string\n  }>(),\n  { icon: 'user-circle', ar: '4/5' }\n)\n</script>\n\n<template>\n  <div\n    class=\"relative rounded-xl3 overflow-hidden flex items-center justify-center text-white/85\"\n    :style=\"{ aspectRatio: ar, background: src ? 'transparent' : 'linear-gradient(150deg, var(--navy) 0%, var(--blue) 130%)' }\"\n  >\n    <!-- Real photo -->\n    <img\n      v-if=\"src\"\n      :src=\"src\"\n      :alt=\"label || ''\"\n      class=\"absolute inset-0 w-full h-full object-cover\"\n    />\n\n    <!-- Placeholder icon when no photo -->\n    <AppIcon v-else :name=\"icon\" size=\"w-[30%] max-w-[96px] aspect-square\" class=\"opacity-90\" />\n\n    <!--\n      Dark gradient overlay — only rendered when a photo AND a label are present.\n      Covers the bottom ~60 % of the image so the label text is always legible.\n    -->\n    <div\n      v-if=\"src && label\"\n      class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent\"\n    />\n\n    <!-- Label / caption text — sits on top of the overlay -->\n    <div\n      v-if=\"label\"\n      class=\"absolute bottom-0 left-0 right-0 px-4 py-4 font-sans text-xs tracking-[0.07em] uppercase font-semibold\"\n      :class=\"src ? 'text-white' : 'text-white/75'\"\n    >\n      {{ label }}\n    </div>\n  </div>\n</template>\n"],"version":3}